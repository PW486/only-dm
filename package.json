{
  "name": "only-dm",
  "private": true,
  "version": "0.2.9",
  "description": "OnlyDM is a lightweight desktop direct message client for Instagram.",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "i18n:check": "node scripts/check-i18n.mjs",
    "icons:check": "node scripts/test-icon-fixtures.mjs",
    "test": "npm run i18n:check && npm run icons:check",
    "release": "node scripts/release.mjs",
    "assets:icons": "python3 scripts/generate-icons.py",
    "assets:og": "python3 scripts/generate-og.py",
    "screenshot": "python3 scripts/capture-screenshot.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
