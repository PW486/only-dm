{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnlyDM",
  "version": "0.1.1",
  "identifier": "com.onlydm.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OnlyDM",
        "url": "https://www.instagram.com/direct/inbox/",
        "width": 1050,
        "height": 750,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "bundleVersion": "2",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  }
}
