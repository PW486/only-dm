{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnlyDM",
  "version": "0.2.0",
  "identifier": "com.onlydm.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OnlyDM",
        "url": "https://www.instagram.com/direct/inbox/",
        "width": 1050,
        "height": 750,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "bundleVersion": "4",
      "signingIdentity": "-",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0OUY2OTI1Rjk0RjU0RTAKUldUZ1ZFLzVKV21mZERuTUhtakY2U01Za2NkNExEWjhwckZXR1RFYmp0V1lRRXBBOXk5QU5YeTUK",
      "endpoints": [
        "https://github.com/PW486/only-dm/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
